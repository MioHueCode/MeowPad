<?xml version="1.0" encoding="utf-8"?>
<!-- MeowPad 图标前景：猫耳 + 便签页 + 文字行。
     自适应图标规范：108dp 画布，安全区居中 72dp（x/y 18..90）。
     比例对齐 Kori：便签主体约占画布 52%（Kori 为 64/108 ≈ 59%，此处略收使留白更充足）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 猫耳（左）：与便签顶边相连，不额外增加整体高度 -->
    <path
        android:fillColor="#F2C94C"
        android:pathData="M38.5,42.5 L36.8,29.4 L48.3,36.8 Z" />
    <!-- 猫耳（右） -->
    <path
        android:fillColor="#F2C94C"
        android:pathData="M69.5,42.5 L71.2,29.4 L59.7,36.8 Z" />

    <!-- 便签主体：32.7..75.3 x 37.6..78.6（约 43x41，占画布 40%） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37.2,37.6 L70.8,37.6 A5,5 0 0 1 75.3,42.6 L75.3,73.6 A5,5 0 0 1 70.8,78.6 L37.2,78.6 A5,5 0 0 1 32.7,73.6 L32.7,42.6 A5,5 0 0 1 37.2,37.6 Z" />

    <!-- 文字行（用圆形端点的描边代替胶囊填充，边缘更锐利） -->
    <path
        android:strokeColor="#1B1B2F"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M41,48.3 L57.3,48.3" />
    <path
        android:strokeColor="#6C6C8A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M41,58.3 L67.1,58.3" />
    <path
        android:strokeColor="#6C6C8A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M41,68.3 L60.6,68.3" />
</vector>
